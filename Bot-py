    if state == "report_step_email":
        context.user_data["report_email"] = text
        context.user_data["state"] = "report_step_subject"
        await update.message.reply_text(
            "🚨 **[ İHBAR OLUŞTURMA - ADIM 2/3 ]**\n"
            "━━━ ━━━━━━━━━━━━━━━━━━━━━━━\n"
