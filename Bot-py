            SENDER_PASSWORD = "uygulama_sifren_buraya"       # Gmail'den aldığın 16 haneli uygulama şifresi
            RECEIVER_EMAIL = "ihbar@siberguvenlik.gov.tr"    # İhbarın gideceği resmi adres
