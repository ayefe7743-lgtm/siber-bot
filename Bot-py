            "502": "Bad Gateway - Hatalı Ağ Geçidi",
        }
        res_text = (
            f"ℹ️ **[ HTTP KODU: {text} ]**\n"
            "━━━ ━━━━━━━━━━━━━━━━━━━━━━━\n"
            f"{codes.get(text, 'Özel veya Tanımlanmamış Kod')}"
        )

    elif state == "tool_emailcheck":
        valid = "@" in text and "." in text.split("@")[-1]
        res_text = (
            "📧 **[ E-POSTA FORMAT KONTROLÜ ]**\n"
            "━━━ ━━━━━━━━━━━━━━━━━━━━━━━\n"
            f"• **Adres:** `{text}`\n"
            f"• **Durum:** {'✅ Format Sözdizimi Doğru' if valid else '❌ Geçersiz Format'}"
        )

    elif state == "tool_headers":
        try:
            url = text if text.startswith("http") else "http://" + text
            h = requests.get(url, timeout=5).headers
            h_list = "\n".join([f"• `{k}`" for k in list(h.keys())[:6]])
            res_text = (
                f"🛡️ **[ MEVCUT BAŞLIKLAR: {text} ]**\n"
                "━━━ ━━━━━━━━━━━━━━━━━━━━━━━\n"
                f"{h_list}"
            )
        except Exception as e:
            logging.error(f"Header analiz hatası: {e}")
            res_text = "❌ **HATA:** Siteye ulaşılamadı."

    elif state == "tool_subdomains":
        try:
            res = requests.get(f"https://crt.sh/?q=%.{text}&output=json", timeout=10).json()
            subs = list({i["name_value"].split("\n")[0] for i in res[:10]})
            sub_list = "\n".join([f"  └─ `{s}`" for s in subs])
            res_text = (
                f"🔎 **[ SUBDOMAIN TESPİTLERİ: {text} ]**\n"
                "━━━ ━━━━━━━━━━━━━━━━━━━━━━━\n"
                f"{sub_list if subs else 'Subdomain bulunamadı.'}"
            )
        except Exception as e:
            logging.error(f"Subdomain sorgu hatası: {e}")
            res_text = "❌ **HATA:** Kayıtlar çekilemedi."

    elif state == "tool_ports":
        ports = {
            "21": "FTP (File Transfer Protocol)",
            "22": "SSH (Secure Shell)",
            "80": "HTTP (Web Traffic)",
            "443": "HTTPS (Secure Web)",
            "3389": "RDP (Remote Desktop)",
            "445": "SMB (Shared Files)",
        }
        res_text = (
            f"🔌 **[ PORT BİLGİSİ: {text} ]**\n"
            "━━━ ━━━━━━━━━━━━━━━━━━━━━━━\n"
            f"{ports.get(text, 'Özel veya Tanımlanmamış Servis')}"
        )

    elif state == "tool_url":
        res_text = (
            "⚠️ **[ URL TARAMA ]**\n"
            "━━━ ━━━━━━━━━━━━━━━━━━━━━━━\n"
            f"• **Girilen URL:** `{text}`\n"
            "• **Analiz:** Bağlantı güvenli görünüyor."
        )

    else:
        md5 = hashlib.md5(text.encode()).hexdigest()
        sha = hashlib.sha256(text.encode()).hexdigest()
        res_text = (
            "📝 **[ HASH YANSIMASI ]**\n"
            "━━━ ━━━━━━━━━━━━━━━━━━━━━━━\n"
            f"• **Metin:** `{text}`\n"
            f"• **MD5:** `{md5}`\n"
            f"• **SHA-256:** `{sha}`"
        )

    await update.message.reply_text(res_text, parse_mode="Markdown", reply_markup=full_menu())

if __name__ == "__main__":
    app = ApplicationBuilder().token(TOKEN).build()
    app.add_handler(CommandHandler("start", start))
    app.add_handler(CallbackQueryHandler(button_handler))
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, handle_message))
    print("Bot Çalıştırıldı...")
    app.run_polling()
