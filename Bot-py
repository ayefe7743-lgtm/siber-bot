        await update.message.reply_text(
            "🚨 **[ İHBAR OLUŞTURMA - ADIM 3/3 ]**\n"
            "━━━ ━━━━━━━━━━━━━━━━━━━━━━━\n"
            "Lütfen ihbar **açıklamasını ve detaylarını** yazınız:",
            parse_mode="Markdown",
